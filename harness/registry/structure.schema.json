{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "harness/registry/structure.schema.json",
  "title": "Harness host structure",
  "description": "Host facts read by every kernel file through harness_registry.load_structure or hook_io.load_structure. Five fixed lanes; a lane is a non-empty list of repo-relative POSIX paths or null when not configured. brain.local_path may also be a home-relative path under ~/ instead of a repository-relative one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lanes",
    "git",
    "outbound_globs",
    "brain",
    "tiers",
    "delegation",
    "selection_scope",
    "contract",
    "host"
  ],
  "definitions": {
    "repoRelativePath": {
      "description": "A safe relative path: no leading slash, no drive letter, no .. escape, no backslash. brain.local_path is the one field that uses this definition for a path that may be home-relative under ~/ rather than repository-relative.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.\\.(?:/|$))(?!.*/\\.\\.(?:/|$))[^\\\\]+$"
    },
    "lane": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/repoRelativePath"
          }
        }
      ]
    },
    "tierLabel": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "secret"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "knowledge",
        "decisions",
        "records",
        "docs"
      ],
      "properties": {
        "identity": {
          "$ref": "#/definitions/lane"
        },
        "knowledge": {
          "$ref": "#/definitions/lane"
        },
        "decisions": {
          "$ref": "#/definitions/lane"
        },
        "records": {
          "$ref": "#/definitions/lane"
        },
        "docs": {
          "$ref": "#/definitions/lane"
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "main-only",
            "branches"
          ]
        }
      }
    },
    "outbound_globs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "write_deny": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "globs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "except": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "brain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_tracked",
        "local_path"
      ],
      "properties": {
        "local_tracked": {
          "type": "boolean"
        },
        "local_path": {
          "$ref": "#/definitions/repoRelativePath"
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_defaults",
        "unlisted_path"
      ],
      "properties": {
        "lane_defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "knowledge",
            "decisions",
            "records",
            "docs"
          ],
          "properties": {
            "identity": {
              "$ref": "#/definitions/tierLabel"
            },
            "knowledge": {
              "$ref": "#/definitions/tierLabel"
            },
            "decisions": {
              "$ref": "#/definitions/tierLabel"
            },
            "records": {
              "$ref": "#/definitions/tierLabel"
            },
            "docs": {
              "$ref": "#/definitions/tierLabel"
            }
          }
        },
        "unlisted_path": {
          "type": "string",
          "enum": [
            "internal",
            "exclude"
          ]
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mandatory"
      ],
      "properties": {
        "mandatory": {
          "type": "boolean"
        }
      }
    },
    "selection_scope": {
      "type": "string",
      "enum": [
        "repo",
        "user"
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "rendered",
            "host-owned"
          ]
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adopted",
        "roots",
        "harness_owned"
      ],
      "properties": {
        "adopted": {
          "type": "boolean"
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/repoRelativePath"
          }
        },
        "harness_owned": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/repoRelativePath"
          }
        },
        "profile": {
          "type": "string",
          "enum": [
            "solo",
            "team"
          ]
        },
        "verify_command": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(npm run|pnpm run|yarn|make) [A-Za-z0-9][A-Za-z0-9:_.-]*$"
            }
          ]
        }
      }
    }
  }
}
